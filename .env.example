# ============================================================
# kb-workbench 生产配置样例
#
# 用法：cp .env.example .env，按注释改几项即可。
# docker compose 会自动读取同目录的 .env（见 docker-compose.yml 的 env_file）。
#
# 只列「上生产前应该确认一遍」的项；完整可调项见 backend/app/config.py。
# 变量名与 config.py 的字段一一对应（大写形式）。
# ============================================================

# ---------- 必改 ----------

# 初始管理员口令。**只在库里一个用户都没有时生效**，登录后会强制改密。
# 生成一个强口令：openssl rand -base64 24
KB_ADMIN_PASSWORD=change-me-before-deploy

# ---------- 路径与存储 ----------

# 文件原文存储方式：fs = 外置到文件系统（推荐），db = 存进 SQLite BLOB
KB_FILE_STORE=fs
# 元数据库目录（宿主机路径，容器内固定挂到 /app/data）。
# 安装目录只有几百 KB，真正会长大的是下面这四个目录 ——
# 空间不够时搬它们就够了，不用动安装目录：
#     bash scripts/move-data.sh /data/kb-workbench
KB_DATA_DIR=./data
# 文件原文目录（宿主机路径，容器内固定挂到 /app/files）
KB_FILE_STORE_DIR=./files
# 备份目录（**宿主机**路径，容器内固定挂到 /app/backups）。
# 生产请指向另一块物理盘或网络存储，与 data/files 同盘时单盘故障会一起带走。
KB_BACKUP_DIR=./backups
# 第二块盘的挂载位（宿主机路径，容器内固定挂到 /mnt/kb-backup）。
# 挂上之后，界面「系统设置 → 备份目录」的下拉里会直接出现它，点一下就切换，
# 不用改 compose、也不用重启容器。留空则用同目录下的 ./backups-alt。
KB_BACKUP_ALT_HOST_DIR=/Volumes/backup-disk/kb-backups
# 声明哪些容器内挂载点在宿主机上是「独立于数据盘的备份盘」（逗号分隔）。
# 为什么需要人工声明：Docker Desktop 下所有 bind mount 都呈现为同一个伪设备，
# 容器内用 st_dev 分不出宿主机的磁盘边界。Linux 宿主能自动判断，可留空。
BACKUP_SEPARATE_MOUNTS=/mnt/kb-backup
# 备份保留份数。快照之间用硬链接共享未变动的文件，不会真的占 N 倍空间。
# 这一项也能在界面「系统设置」里改，界面设置优先、且立即生效。
KB_BACKUP_KEEP=14

# ---------- 容量与限流 ----------

# 单次上传硬上限（MB）。超过返回 413。
# 注意：前端 nginx 的 client_max_body_size 是 1024m，改这里要同步改
# frontend/nginx.conf，否则会先被 nginx 拦下、返回非 JSON 错误页。
UPLOAD_MAX_MB=4096
# 单文件超过该体积时在响应里附一条提示（不阻止上传）
LARGE_FILE_WARN_MB=200

# ---------- SQLite 调优 ----------

# 页缓存（MB）。热数据超过这个量就会反复回读磁盘。
SQLITE_CACHE_MB=64
# 内存映射上限（MB）。读多写少的场景收益最明显；0 = 关闭。
SQLITE_MMAP_MB=256
# WAL 自动检查点阈值（页，每页 4KB）。1000 ≈ 4MB。
SQLITE_WAL_AUTOCHECKPOINT=1000

# ---------- 安全 ----------

# 是否启用登录鉴权。生产必须 true。
KB_AUTH_ENABLED=true
# 会话有效期（天）
KB_SESSION_DAYS=14
# Cookie 是否只允许 HTTPS 传输。
# 用 nginx/Caddy 套了 HTTPS 就改成 true；纯 HTTP 内网保持 false，
# 否则浏览器根本不会保存这个 Cookie，表现为「登录成功但一直跳回登录页」。
KB_COOKIE_SECURE=false
# 跨域允许来源（JSON 数组）。默认空 = 只允许同源。
# 前端由 nginx 反代 /api、开发态走 vite proxy，两种模式都是同源，不需要配置。
# 只有前端单独部署在别的域名时才需要，例如：
#   KB_CORS_ORIGINS=["https://kb.example.com"]
# 设成 ["*"] 会自动关闭 Cookie 传递（浏览器禁止两者共存），跨域登录会失效。
KB_CORS_ORIGINS=[]

# ---------- 后台维护 ----------

# 关掉之后，过期会话/审计日志/WAL 只会在启动和关停时清理一次，
# 长跑数月的实例会慢慢积累垃圾。生产保持 true。
KB_MAINTENANCE_ENABLED=true
# 过期会话清理间隔（分钟）
KB_SESSION_SWEEP_MINUTES=5
# 审计日志清理 + 查询计划刷新间隔（分钟）
KB_AUDIT_SWEEP_MINUTES=60
# 审计日志保留天数，0 = 不清理
KB_AUDIT_KEEP_DAYS=180
# 定期 WAL 检查点间隔（分钟）
KB_CHECKPOINT_MINUTES=30
# 库自检缓存刷新间隔（分钟），/api/health 读这个缓存值
KB_HEALTH_PROBE_MINUTES=10

# ---------- 日志 ----------

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------- 升级更新（GitHub Releases）----------

# GitHub 仓库标识（owner/name）。设置后系统设置页可「检查更新」
KB_UPDATE_REPO=
# 容器访问 GitHub API 的 http 代理（直连可达就留空）
KB_UPDATE_PROXY=
